          "name": "List recent operations",
          "request": {
            "name": "List recent operations",
            "description": {
              "content": "List your most-recent background operations, scoped to the active organization and the requesting user. Use this to recover an `operationId` you no longer have. Ordered newest-first; `limit` returns up to that many (default 20, max 100). Optional `status` filters to a single operation status.",
              "type": "text/plain"
            },
